# Banco PostgreSQL (Neon ou outro)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# JWT (obrigatório em produção - use valores aleatórios e seguros)
JWT_SECRET=your_jwt_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production

# Porta do servidor
PORT=3000

# Push Notifications (obrigatório para ativar notificações no app)
# Gerar com: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# JSONBin (opcional - para o frontend, defina window.__JSONBIN_CONFIG__ = { masterKey, binId } ou use config não versionado)
# JSONBIN_MASTER_KEY=
# JSONBIN_BIN_ID=
